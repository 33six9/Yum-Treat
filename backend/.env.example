# Copy this file to .env and fill in your own values

# MongoDB connection string (local Mongo or MongoDB Atlas)
MONGO_URI=

# Port the API server listens on (frontend expects http://localhost:5000)
PORT=5000

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000

# --- Firebase Admin SDK ---
# From your Firebase project: Project settings -> Service accounts -> Generate new private key.
# Paste the matching fields from the downloaded JSON below.
# IMPORTANT: keep FIREBASE_PRIVATE_KEY quoted, with \n for line breaks (Firebase's own format).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Comma-separated emails that are auto-promoted to the "admin" role the
# first time they sign in (or on their next sign-in if added later).
# This never demotes an existing admin.
ADMIN_EMAILS=admin@yumtreat.com
